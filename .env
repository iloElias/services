# PostgreSQL
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="postgres"

# PgBouncer
DB_HOST="postgres"
DB_PORT="5432"
DB_NAME="postgres"
DB_USER="postgres"
DB_PASSWORD="postgres"
ADMIN_USERS="postgres"
POOL_MODE="transaction"
MAX_CLIENT_CONN="100"
DEFAULT_POOL_SIZE="20"
MIN_POOL_SIZE="5"
RESERVE_POOL_SIZE="5"
AUTH_TYPE="scram-sha-256"
AUTH_FILE="/etc/pgbouncer/userlist.txt"

# PostgreSQL connection aliases used by PgBouncer
PGBOUNCER_DB_HOST="postgres"
PGBOUNCER_DB_PORT="5432"
PGBOUNCER_DB_NAME="postgres"
PGBOUNCER_DB_USER="postgres"
PGBOUNCER_DB_PASSWORD="postgres"

# MySQL
MYSQL_USER="root"
MYSQL_PASSWORD="root"
MYSQL_ROOT_PASSWORD="root"

# RabbitMQ
RABBITMQ_DEFAULT_USER="rabbitmq"
RABBITMQ_DEFAULT_PASS="rabbitmq"
RABBITMQ_DISK_FREE_LIMIT="50MB"
RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS="-rabbit log_levels [{connection,error},{default,error}] disk_free_limit 50MB"

# Jenkins
JENKINS_PASSWORD="password"

# MinIO
MINIO_ROOT_USER="user"
MINIO_ROOT_PASSWORD="password"

# RustFS
RUSTFS_ACCESS_KEY="admin"
RUSTFS_SECRET_KEY="4e80ca9b7642a97b75f2fa7d47271e46"
RUSTFS_VOLUMES="/data"
RUSTFS_ADDRESS="0.0.0.0:9100"
RUSTFS_CONSOLE_ADDRESS="0.0.0.0:9101"
RUSTFS_CONSOLE_ENABLE="true"
RUSTFS_CORS_ALLOWED_ORIGINS="*"
RUSTFS_CONSOLE_CORS_ALLOWED_ORIGINS="*"
RUSTFS_OBS_LOGGER_LEVEL="info"
RUSTFS_UNSAFE_BYPASS_DISK_CHECK="false"

# Redis
# No external variables are currently required.
